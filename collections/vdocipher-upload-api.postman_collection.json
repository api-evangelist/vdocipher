          "request": {
            "name": "Obtain upload credentials",
            "description": {
              "content": "Reserves a new videoId and returns short-lived AWS S3 credentials (clientPayload) used to upload the source file directly to storage.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "videos"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "title",
                  "value": "<string>",
                  "description": "(Required) Title for the new video."
                },
                {
                  "disabled": false,
                  "key": "folderId",
                  "value": "root",
                  "description": "Folder to place the video in. Defaults to root."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null
          },
          "response": [
            {
              "id": "083e5a66-394d-47de-8192-2cbaf6a46c61",
