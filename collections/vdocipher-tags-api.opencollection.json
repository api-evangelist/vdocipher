{
  "opencollection": "1.0.0",
  "info": {
    "name": "VdoCipher Server Folders Tags API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dev.vdocipher.com/api/videos/tags"
          },
          "docs": "Returns all tags applied across the account's videos."
        }
      ]
    }
  ],
  "bundled": true
}